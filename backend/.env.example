# Copy to backend/.env for local development (.env is git-ignored).
# Every variable can instead be given as NAME_FILE=/path/to/file, which is how
# Docker Swarm secrets are passed in production. Setting both is an error.
#
# Database and Redis values match the root compose.yaml and .env.example
# (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB). If you change those in the
# root .env, change them here too. Use 127.0.0.1 rather than localhost: Compose
# publishes the ports on IPv4 only, and localhost can resolve to IPv6 first.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# Required. Compose publishes Postgres on host port 5433.
DATABASE_URL=postgres://inventory_user@127.0.0.1:5433/inventory_db
DATABASE_PASSWORD=replace_with_local_password
# DATABASE_POOL_MAX=10

# Enables sessions under /api. Must be at least 32 bytes, e.g. `openssl rand -base64 48`.
# Without it, routes that need a signed-in user (such as stock operations) return 401.
# SESSION_SECRET=

# Real-time updates (Socket.IO Redis adapter).
REDIS_URL=redis://127.0.0.1:6379

# Directory with the built React app. Leave unset to serve only the API.
# STATIC_DIR=../frontend/dist

# How long to wait for in-flight requests on SIGTERM before exiting.
# SHUTDOWN_TIMEOUT_MS=10000

# Tests only. The stock tests create and drop a throwaway database per test
# file, so this role needs CREATEDB (the Compose user is a superuser).
TEST_DATABASE_URL=postgres://inventory_user:replace_with_local_password@127.0.0.1:5433/inventory_db
